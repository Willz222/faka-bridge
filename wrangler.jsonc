{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "faka-bridge",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-18",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "APP_NAME": "Faka Bridge",
    "APP_VERSION": "0.2.0",
    "SESSION_TTL_SECONDS": "28800"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "faka-bridge-db",
      "database_id": "请替换为你的D1数据库ID",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "5001",
      "simple": {
        "limit": 180,
        "period": 60
      }
    },
    {
      "name": "ORDER_RATE_LIMITER",
      "namespace_id": "5002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["*/2 * * * *"]
  }
}
